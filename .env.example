# Base de données
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/esg_mefali

# Sécurité
SECRET_KEY=changez-cette-cle-en-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# IA (OpenRouter)
OPENROUTER_API_KEY=votre-cle-openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-4-20250514

# Embeddings F12 (mémoire pgvector). Requiert un compte OpenAI direct.
# Si vide, F12 fonctionne en mode dégradé (chunks insérés sans embedding).
OPENAI_API_KEY=

# Frontend
NUXT_PUBLIC_API_BASE=http://localhost:8000/api

# --- Feature flags F047 (Évaluation ESG-projet, mig. 047) ---
# Active/cache l'UI évaluation ESG-projet côté frontend (wizard + page /esg projet).
# Valeurs : true (défaut, UI exposée) | false (composants masqués, rollback)
NUXT_PUBLIC_ENABLE_PROJECT_ESG_ASSESSMENT=true

# Backend : désactive les 5 tools LangChain ESG-projet en cas de bug LLM.
# Valeurs : false (défaut, tools actifs) | true (cachés du selecteur)
DISABLE_PROJECT_ESG_TOOLS=false

# Backend : matching projet-centric priorise ProjectEsgAssessment calculé
# sur la saisie manuelle F045.
# Valeurs : true (défaut, cascade calculated → manual_f045 → unsourced)
#          | false (revient au comportement pré-047)
MATCHING_USE_PROJECT_ESG_ASSESSMENTS=true
