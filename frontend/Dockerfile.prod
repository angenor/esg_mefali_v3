# ========================================
# Stage 1 : build Nuxt 4
# ========================================
FROM node:24-slim AS builder

WORKDIR /app

# Installer les dépendances. Le lockfile est généré sous macOS et `npm ci`
# échoue sous Linux (résolution divergente des dépendances optionnelles
# multiplateformes — bug npm connu), ce qui laissait un node_modules partiel
# cassant la résolution des alias Nuxt (`~/...`) au build. On force donc une
# installation propre sous Linux à partir du seul package.json.
# NB : non strictement reproductible (pas de lock figé) ; à régénérer un
# lockfile Linux si une reproductibilité stricte devient nécessaire.
COPY package.json ./
RUN npm install --no-audit --no-fund

# Copier le code source
COPY . .

# Variable d'environnement injectée au build (chemin relatif via Nginx)
ARG NUXT_PUBLIC_API_BASE=/api
ENV NUXT_PUBLIC_API_BASE=$NUXT_PUBLIC_API_BASE

# Générer .nuxt/ (dont tsconfig.json avec le mapping de l'alias `~`) AVANT le
# build : sinon @vue/compiler-sfc tente de résoudre les types importés dans les
# defineProps (ex. `~/types/richblocks`) avant que `nuxt build` n'écrive ce
# tsconfig, et échoue avec « Failed to resolve import source ».
RUN npx nuxi prepare

# Build Nuxt (SSR) -> sortie dans .output/
RUN npm run build

# ========================================
# Stage 2 : runtime minimal
# ========================================
FROM node:24-slim AS runner

WORKDIR /app

# Copier uniquement la sortie de build
COPY --from=builder /app/.output ./.output

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000
ENV NITRO_PORT=3000

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD node -e "fetch('http://localhost:3000/').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", ".output/server/index.mjs"]
